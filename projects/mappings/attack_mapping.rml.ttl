@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix ex: <http://w3id.org/sepses/vocab/ref/attack#> .

# ==========================================================
# Logical Source
# ==========================================================
<#Source>
    a rml:LogicalSource ;
    rml:source "mobile-attack-1.0.json" ;
    rml:iterator "$.objects[*]" ;
    rml:referenceFormulation ql:JSONPath .

<#Bundle>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "mobile-attack-1.0.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$"       # root JSON
    ] ;

    rr:subjectMap [
        rr:template "http://w3id.org/attack/{id}" ;
        rr:class ex:Bundle ;
        rr:condition [ rml:reference "type" ; rr:pattern "bundle" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:specVersion ;
        rr:objectMap [ rml:reference "spec_version" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:containsObject ;
        rr:objectMap [
            rr:template "http://w3id.org/attack/{objects[*].id}"
        ]
    ] .

# ==========================================================
# 1) COLLECTION: x-mitre-collection
# ==========================================================
<#Collection>
    a rr:TriplesMap ;
    rml:logicalSource <#Source> ;

    rr:subjectMap [
        rr:template "http://w3id.org/attack/{id}" ;
        rr:class ex:Collection ;
        rr:condition [
            rml:reference "type" ;
            rr:pattern "x-mitre-collection"
        ]
    ] ;

    ############ UNIVERSAL METADATA ############

    rr:predicateObjectMap [
        rr:predicate ex:createdBy ;
        rr:objectMap [ rml:reference "created_by_ref" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:dateCreated ;
        rr:objectMap [ rml:reference "created" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:dateModified ;
        rr:objectMap [ rml:reference "modified" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:hasMarking ;
        rr:objectMap [
            rr:template "http://w3id.org/attack/{object_marking_refs[*]}" ;
            rml:optional true
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:attackSpecVersion ;
        rr:objectMap [ rml:reference "x_mitre_attack_spec_version" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:domain ;
        rr:objectMap [ rml:reference "x_mitre_domains[*]" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:modifiedBy ;
        rr:objectMap [ rml:reference "x_mitre_modified_by_ref" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:mitreVersion ;
        rr:objectMap [ rml:reference "x_mitre_version" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate schema:name ;
        rr:objectMap [ rml:reference "name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:description ;
        rr:objectMap [ rml:reference "description" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate schema:version ;
        rr:objectMap [ rml:reference "x_mitre_version" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:contains ;
        rr:objectMap [
            rr:template "http://w3id.org/attack/{x_mitre_contents[*].object_ref}"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:hasMarking ;
        rr:objectMap [
            rr:template "http://w3id.org/attack/{object_marking_refs[*]}" ;
            rml:optional true
        ]
    ] .

# ==========================================================
# 2) ATTACK-PATTERN
# ==========================================================
<#AttackPattern>
    a rr:TriplesMap ;
