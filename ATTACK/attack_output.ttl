<http://w3id.org/attack/attack-pattern--82f04b1e-5371-4a6f-be06-411f0f43b483> a <http://w3id.org/sepses/vocab/ref/attack#AttackPattern> , <http://w3id.org/sepses/vocab/ref/attack#CourseOfAction> , <http://w3id.org/sepses/vocab/ref/attack#Collection> , <http://w3id.org/sepses/vocab/ref/attack#Relationship> , <http://w3id.org/sepses/vocab/ref/attack#Malware> , <http://w3id.org/sepses/vocab/ref/attack#Tool> , <http://w3id.org/sepses/vocab/ref/attack#IntrusionSet> ;
	<http://schema.org/name> "Abuse Device Administrator Access to Prevent Removal" ;
	<http://schema.org/description> "A malicious application can request Device Administrator privileges. If the user grants the privileges, the application can take steps to make its removal more difficult.  Detection: The device user can view a list of apps with Device Administrator privilege in the device settings.  Platforms: Android" ;
	<http://w3id.org/sepses/vocab/ref/attack#platform> "Android" ;
	<http://schema.org/dateModified> "2018-01-17T12:56:55.080Z" ;
	<http://w3id.org/sepses/vocab/ref/attack#attackSpecVersion> "2.1.0" ;
