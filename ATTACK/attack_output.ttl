<http://w3id.org/attack/attack-pattern--6b846ad0-cc20-4db6-aa34-91561397c5e2> a <http://w3id.org/sepses/vocab/ref/attack#AttackPattern> , <http://w3id.org/sepses/vocab/ref/attack#CourseOfAction> , <http://w3id.org/sepses/vocab/ref/attack#Collection> , <http://w3id.org/sepses/vocab/ref/attack#Relationship> , <http://w3id.org/sepses/vocab/ref/attack#Malware> , <http://w3id.org/sepses/vocab/ref/attack#Tool> , <http://w3id.org/sepses/vocab/ref/attack#IntrusionSet> ;
	<http://schema.org/name> "App Delivered via Web Download" ;
	<http://schema.org/description> "The application is downloaded from an arbitrary web site. A link to the application's download URI may be sent in an email or SMS, placed on another web site that the target is likely to view, or sent via other means (such as QR code).  Detection: An EMM/MDM or mobile threat protection solution can identify the presence of unwanted, known insecure, or malicious apps on devices.  Platforms: Android, iOS" ;
	<http://w3id.org/sepses/vocab/ref/attack#platform> "Android" , "iOS" ;
	<http://schema.org/dateModified> "2018-01-17T12:56:55.080Z" ;
	<http://w3id.org/sepses/vocab/ref/attack#attackSpecVersion> "2.1.0" ;
