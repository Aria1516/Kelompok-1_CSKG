<http://w3id.org/attack/attack-pattern--633baf01-6de4-4963-bb54-ff6c6357bed3> a <http://w3id.org/sepses/vocab/ref/attack#AttackPattern> , <http://w3id.org/sepses/vocab/ref/attack#CourseOfAction> , <http://w3id.org/sepses/vocab/ref/attack#Collection> , <http://w3id.org/sepses/vocab/ref/attack#Relationship> , <http://w3id.org/sepses/vocab/ref/attack#Malware> , <http://w3id.org/sepses/vocab/ref/attack#Tool> , <http://w3id.org/sepses/vocab/ref/attack#IntrusionSet> ;
	<http://schema.org/name> "Rogue Wi-Fi Access Points" ;
	<http://schema.org/description> "An adversary could set up unauthorized Wi-Fi access points or compromise existing access points and, if the device connects to them, carry out network-based attacks such as eavesdropping on or modifying network communication as described in NIST SP 800-153 (Citation: NIST-SP800153).   For example, Kaspersky describes a threat actor they call DarkHotel that targeted hotel Wi-Fi networks, using them to compromise computers belonging to business executives (Citation: Kaspersky-DarkHotel).  Platforms: Android, iOS" ;
	<http://w3id.org/sepses/vocab/ref/attack#platform> "Android" , "iOS" ;
	<http://schema.org/dateModified> "2018-01-17T12:56:55.080Z" ;
	<http://w3id.org/sepses/vocab/ref/attack#attackSpecVersion> "2.1.0" ;
	<http://w3id.org/sepses/vocab/ref/attack#hasMarking> <http://w3id.org/attack/marking-definition--fa42a846-8d90-4e51-bc29-71d5b4802168> ;
	<http://w3id.org/sepses/vocab/ref/attack#createdBy> "identity--c78cb6e5-0c4b-4611-8297-d1b8b55e40b5" ;
	<http://schema.org/dateCreated> "2017-10-25T14:48:21.354Z" ;
