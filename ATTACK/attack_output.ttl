<http://w3id.org/attack/attack-pattern--a0464539-e1b7-4455-a355-12495987c300> a <http://w3id.org/sepses/vocab/ref/attack#AttackPattern> , <http://w3id.org/sepses/vocab/ref/attack#CourseOfAction> , <http://w3id.org/sepses/vocab/ref/attack#Collection> , <http://w3id.org/sepses/vocab/ref/attack#Relationship> , <http://w3id.org/sepses/vocab/ref/attack#Malware> , <http://w3id.org/sepses/vocab/ref/attack#Tool> , <http://w3id.org/sepses/vocab/ref/attack#IntrusionSet> ;
	<http://schema.org/name> "Attack PC via USB Connection" ;
	<http://schema.org/description> "With escalated privileges, an adversary could program the mobile device to impersonate USB devices such as input devices (keyboard and mouse), storage devices, and/or networking devices in order to attack a physically connected PC. Wang and Stavrou (Citation: Wang-ExploitingUSB) and Kamkar (Citation: ArsTechnica-PoisonTap) describe this technique. This technique has been demonstrated on Android, and we are unaware of any demonstrations on iOS.  Platforms: Android" ;
	<http://w3id.org/sepses/vocab/ref/attack#platform> "Android" ;
	<http://schema.org/dateModified> "2018-01-17T12:56:55.080Z" ;
	<http://w3id.org/sepses/vocab/ref/attack#attackSpecVersion> "2.1.0" ;
