<http://w3id.org/attack/attack-pattern--0bcc4ec1-a897-49a9-a9ff-c00df1d1209d> a <http://w3id.org/sepses/vocab/ref/attack#AttackPattern> , <http://w3id.org/sepses/vocab/ref/attack#CourseOfAction> , <http://w3id.org/sepses/vocab/ref/attack#Collection> , <http://w3id.org/sepses/vocab/ref/attack#Relationship> , <http://w3id.org/sepses/vocab/ref/attack#Malware> , <http://w3id.org/sepses/vocab/ref/attack#Tool> , <http://w3id.org/sepses/vocab/ref/attack#IntrusionSet> ;
	<http://schema.org/name> "Malicious SMS Message" ;
	<http://schema.org/description> "An SMS message could contain content designed to exploit vulnerabilities in the SMS parser on the receiving device. For example, Mulliner and Miller demonstrated such an attack against the iPhone in 2009 as described in  (Citation: Forbes-iPhoneSMS).  An SMS message could also contain a link to a web site containing malicious content designed to exploit the device web browser.  As described by SRLabs in  (Citation: SRLabs-SIMCard), vulnerable SIM cards may be remotely exploited and reprogrammed via SMS messages.  Platforms: Android, iOS" ;
	<http://w3id.org/sepses/vocab/ref/attack#platform> "Android" , "iOS" ;
	<http://schema.org/dateModified> "2018-01-17T12:56:55.080Z" ;
