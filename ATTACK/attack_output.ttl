<http://w3id.org/attack/course-of-action--ff4821f6-5afb-481b-8c0f-26c28c0d666c> a <http://w3id.org/sepses/vocab/ref/attack#AttackPattern> , <http://w3id.org/sepses/vocab/ref/attack#CourseOfAction> , <http://w3id.org/sepses/vocab/ref/attack#Collection> , <http://w3id.org/sepses/vocab/ref/attack#Relationship> , <http://w3id.org/sepses/vocab/ref/attack#Malware> , <http://w3id.org/sepses/vocab/ref/attack#Tool> , <http://w3id.org/sepses/vocab/ref/attack#IntrusionSet> ;
	<http://schema.org/name> "Attestation" ;
	<http://schema.org/description> "Enable remote attestation capabilities when available (such as Android SafetyNet or Samsung Knox TIMA Attestation) and prohibit devices that fail the attestation from accessing enterprise resources." ;
	<http://schema.org/dateModified> "2018-01-17T12:56:55.080Z" ;
	<http://w3id.org/sepses/vocab/ref/attack#attackSpecVersion> "2.1.0" ;
	<http://w3id.org/sepses/vocab/ref/attack#hasMarking> <http://w3id.org/attack/marking-definition--fa42a846-8d90-4e51-bc29-71d5b4802168> ;
	<http://w3id.org/sepses/vocab/ref/attack#createdBy> "identity--c78cb6e5-0c4b-4611-8297-d1b8b55e40b5" ;
