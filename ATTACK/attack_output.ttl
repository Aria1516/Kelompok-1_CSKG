<http://w3id.org/attack/course-of-action--e944670c-d03a-4e93-a21c-b3d4c53ec4c9> a <http://w3id.org/sepses/vocab/ref/attack#AttackPattern> , <http://w3id.org/sepses/vocab/ref/attack#CourseOfAction> , <http://w3id.org/sepses/vocab/ref/attack#Collection> , <http://w3id.org/sepses/vocab/ref/attack#Relationship> , <http://w3id.org/sepses/vocab/ref/attack#Malware> , <http://w3id.org/sepses/vocab/ref/attack#Tool> , <http://w3id.org/sepses/vocab/ref/attack#IntrusionSet> ;
	<http://schema.org/name> "Caution with Device Administrator Access" ;
	<http://schema.org/description> "Warn device users not to accept requests to grant Device Administrator access to applications without good reason.  Additionally, application vetting should include a check on whether the application requests Device Administrator access. Applications that do request Device Administrator access should be carefully scrutinized and only allowed to be used if a valid reason exists." ;
	<http://schema.org/dateModified> "2018-01-17T12:56:55.080Z" ;
	<http://w3id.org/sepses/vocab/ref/attack#attackSpecVersion> "2.1.0" ;
