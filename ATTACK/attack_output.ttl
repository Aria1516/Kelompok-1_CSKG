<http://w3id.org/attack/attack-pattern--f296fc9c-2ff5-43ee-941e-6b49c438270a> a <http://w3id.org/sepses/vocab/ref/attack#AttackPattern> , <http://w3id.org/sepses/vocab/ref/attack#CourseOfAction> , <http://w3id.org/sepses/vocab/ref/attack#Collection> , <http://w3id.org/sepses/vocab/ref/attack#Relationship> , <http://w3id.org/sepses/vocab/ref/attack#Malware> , <http://w3id.org/sepses/vocab/ref/attack#Tool> , <http://w3id.org/sepses/vocab/ref/attack#IntrusionSet> ;
	<http://schema.org/name> "Device Unlock Code Guessing or Brute Force" ;
	<http://schema.org/description> "An adversary could make educated guesses of the device lock screen's PIN/password (e.g., commonly used values, birthdays, anniversaries) or attempt a dictionary or brute force attack against it. Brute force attacks could potentially be automated (Citation: PopSci-IPBox).  Platforms: Android, iOS" ;
	<http://w3id.org/sepses/vocab/ref/attack#platform> "Android" , "iOS" ;
	<http://schema.org/dateModified> "2018-01-17T12:56:55.080Z" ;
	<http://w3id.org/sepses/vocab/ref/attack#attackSpecVersion> "2.1.0" ;
