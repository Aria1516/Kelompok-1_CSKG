	<http://schema.org/name> "Use Device-Provided Credential Storage" ;
	<http://schema.org/description> "Application developers should use device-provided credential storage mechanisms such as Android's KeyStore or iOS's KeyChain. These can prevent credentials from being exposed to an adversary." ;
