<http://w3id.org/attack/attack-pattern--a5de0540-73e7-4c67-96da-4143afedc7ed> a <http://w3id.org/sepses/vocab/ref/attack#AttackPattern> , <http://w3id.org/sepses/vocab/ref/attack#CourseOfAction> , <http://w3id.org/sepses/vocab/ref/attack#Collection> , <http://w3id.org/sepses/vocab/ref/attack#Relationship> , <http://w3id.org/sepses/vocab/ref/attack#Malware> , <http://w3id.org/sepses/vocab/ref/attack#Tool> , <http://w3id.org/sepses/vocab/ref/attack#IntrusionSet> ;
	<http://schema.org/name> "Rogue Cellular Base Station" ;
	<http://schema.org/description> "An adversary could set up a rogue cellular base station and then use it to eavesdrop on or manipulate cellular device communication. For example, Ritter and DePerry of iSEC Partners demonstrated this technique using a compromised cellular femtocell at Black Hat USA 2013 (Citation: Computerworld-Femtocell).  Platforms: Android, iOS" ;
	<http://w3id.org/sepses/vocab/ref/attack#platform> "Android" , "iOS" ;
	<http://schema.org/dateModified> "2018-01-17T12:56:55.080Z" ;
